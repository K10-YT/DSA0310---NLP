
import nltk
from nltk.tokenize import word_tokenize

nltk.download('punkt')
nltk.download('punkt_tab')

# Input sentence
sentence = "I book a ticket and read a book"

print("ORIGINAL SENTENCE:")
print(sentence)

# Initial POS tagging
words = word_tokenize(sentence)

initial_tags = []

for word in words:
    if word.lower() in ["i", "he", "she", "they"]:
        tag = "PRP"
    elif word.lower() in ["a", "an", "the"]:
        tag = "DT"
    elif word.lower() in ["book", "read"]:
        tag = "NN"
    else:
        tag = "NN"

    initial_tags.append((word, tag))

print("\nINITIAL POS TAGGING:")
print(initial_tags)

# Transformation rules
print("\nTRANSFORMATION RULES:")

final_tags = initial_tags.copy()

for i in range(len(final_tags) - 1):

    word, tag = final_tags[i]
    next_word, next_tag = final_tags[i + 1]

    # Rule 1: Verb before a determiner
    if tag == "NN" and next_tag == "DT":
        final_tags[i] = (word, "VB")
        print("Rule 1 Applied:", word, "NN -> VB")

    # Rule 2: Verb after pronoun
    if tag == "NN" and i > 0:
        if final_tags[i - 1][1] == "PRP":
            final_tags[i] = (word, "VB")
            print("Rule 2 Applied:", word, "NN -> VB")

print("\nFINAL CORRECTED POS TAGGING:")
print(final_tags)
