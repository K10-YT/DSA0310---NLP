
import re

# Input text
text = """
Artificial intelligence is growing rapidly.
Artificial intelligence helps many industries.
Machine learning is an important part of AI.
It is used in healthcare and education.
Technology improves people's daily lives.
"""

print("ORIGINAL TEXT:")
print(text)

# Split text into sentences
sentences = re.split(r'[.!?]+', text)
sentences = [s.strip().lower() for s in sentences if s.strip()]

print("\nSENTENCE ANALYSIS:")

scores = []

for i in range(len(sentences) - 1):

    words1 = set(re.findall(r'\b\w+\b', sentences[i]))
    words2 = set(re.findall(r'\b\w+\b', sentences[i + 1]))

    common = words1.intersection(words2)

    # Calculate similarity
    similarity = len(common) / len(words1.union(words2))

    scores.append(similarity)

    print("\nSentence", i + 1, ":", sentences[i])
    print("Sentence", i + 2, ":", sentences[i + 1])
    print("Common Words:", common)
    print("Similarity:", round(similarity, 2))

# Overall coherence score
if scores:
    coherence = sum(scores) / len(scores) * 100
else:
    coherence = 0

print("\nCOHERENCE REPORT")
print("Overall Coherence Score:", round(coherence, 2), "%")

if coherence >= 20:
    print("Result: Good Coherence")
elif coherence >= 10:
    print("Result: Moderate Coherence")
else:
    print("Result: Poor Coherence")

print("\nAnalysis Completed Successfully!")
